  <channel>
    <title>vibebuddy</title>
    <item>
      <title>0.1</title>
      <sparkle:version>1</sparkle:version>            <!-- CURRENT_PROJECT_VERSION -->
      <sparkle:shortVersionString>0.1</sparkle:shortVersionString>  <!-- MARKETING_VERSION -->
      <sparkle:minimumSystemVersion>14.0</sparkle:minimumSystemVersion>
      <enclosure
        url="https://REPLACE_WITH_YOUR_HOST/VibeBuddyMacApp-0.1.zip"
        sparkle:edSignature="GENERATED_BY_generate_appcast"
        length="0"
        type="application/octet-stream" />
    </item>
  </channel>
