      "type": "object",
      "properties": {
        "since": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      },
      "additionalProperties": false,
      "required": []
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "vibebuddy_search",
    "description": "Search indexed readable message text literally, with session references and unindexed source coverage.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        },
        "project": {
          "type": "string"
        },
        "agents": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "claude-code",
              "codex",
              "cursor",
              "grok-build"
            ]
          }
        },
        "since": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      },
      "additionalProperties": false,
