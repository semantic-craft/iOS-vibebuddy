[
  {
    "name": "vibebuddy_get_session",
    "description": "Read a transcript by native key or reference; sequence positions are stable for its source revision.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        },
        "from_seq": {
          "type": "integer",
          "minimum": 1
        },
        "max_messages": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "tools": {
          "type": "boolean"
        },
        "thinking": {
          "type": "boolean"
        }
      },
      "required": [
        "key"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "vibebuddy_get_summary",
    "description": "Read an existing conversation summary with its saved coverage and current source staleness; never generates a summary.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "key"
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "vibebuddy_list_sessions",
    "description": "List indexed local sessions, newest activity first.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string"
        },
        "agents": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "claude-code",
              "codex",
              "cursor",
              "grok-build"
            ]
          }
        },
        "since": {
          "type": "string"
        },
        "starred": {
          "type": "boolean"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      },
      "additionalProperties": false,
      "required": []
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "vibebuddy_list_projects",
    "description": "List projects with indexed sessions, newest activity first.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "since": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      },
      "additionalProperties": false,
      "required": []
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "vibebuddy_search",
    "description": "Search indexed readable message text literally, with session references and unindexed source coverage.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "minLength": 1
        },
        "project": {
          "type": "string"
        },
        "agents": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "claude-code",
              "codex",
              "cursor",
              "grok-build"
            ]
          }
        },
        "since": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      },
      "additionalProperties": false,
      "required": [
        "query"
      ]
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "vibebuddy_live_status",
    "description": "Read live sessions grouped by checkout; an optional collaboration hint, not a lock.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "project": {
          "type": "string"
        },
        "exclude_session": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "vibebuddy_handoff_facts",
    "title": "Handoff facts",
    "description": "Read the recorded facts for one session before writing a handoff: rounds ended, the checkout's git HEAD and dirty files now, files edited, commands run with exit codes, and what the observation path could not see. Pass your own session key; the tool never picks a session for you and never generates text.",
    "inputSchema": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "description": "Session key <agent>:<native id> (claude-code, codex, cursor, grok-build) or a vibebuddy://session/ reference; your own session's id."
        },
        "commands": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "default": 20,
          "description": "How many of the most recent commands to list (default 20, at most 50)."
        },
        "cwd": {
          "type": "string",
          "minLength": 1,
          "description": "Absolute checkout path to probe with git; otherwise derived from the files the session edited."
        }
      },
      "required": [
        "key"
      ],
      "additionalProperties": false
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  }
]
