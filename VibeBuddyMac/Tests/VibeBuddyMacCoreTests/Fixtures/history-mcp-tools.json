            "enum": [
              "claude-code",
              "codex",
              "cursor",
              "grok-build"
            ]
          }
        },
        "since": {
          "type": "string"
        },
        "starred": {
          "type": "boolean"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        }
      },
      "additionalProperties": false,
      "required": []
    },
    "annotations": {
      "readOnlyHint": true,
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": false
    }
  },
  {
    "name": "vibebuddy_list_projects",
    "description": "List projects with indexed sessions, newest activity first.",
